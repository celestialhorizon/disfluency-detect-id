  "pola_afiks_reduplikasi": {
    "catatan": "Regex diterapkan pada bentuk bertanda hubung untuk mengenali reduplikasi berafiks yang produktif sehingga tidak perlu didaftar satu per satu.",
    "pola": [
      "^ber([a-z]+)-\\1$",
      "^ter([a-z]+)-\\1$",
      "^([a-z]+)-me[nmngy]?\\1$",
